{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/huntly-site-v44/huntly-site/huntlysitev58",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/huntly-site-v44/huntly-site/huntlysitev58/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/cases/:slug(como-estamos-ajudando-a-odontoprev.*)",
      "destination": "/huntly-recrutamento-especializado#case-odontoprev",
      "permanent": true
    },
    {
      "source": "/cases",
      "destination": "/huntly-recrutamento-especializado#cases",
      "permanent": true
    },
    {
      "source": "/cases/:path*",
      "destination": "/huntly-recrutamento-especializado#cases",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(logos|fotos)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-96x96.png|apple-touch-icon.png|og-image.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/analytics.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
